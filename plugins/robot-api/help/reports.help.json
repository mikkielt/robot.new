{
  "component": "reports",
  "endpoints": [
    {
      "method": "GET",
      "path": "/reports/changelog",
      "handler": "Invoke-ApiGetChangelog",
      "scope": "admin:read",
      "pl": {
        "description": "Zwraca dziennik zmian encji z opcjonalnym filtrowaniem po datach, nazwie encji i zmienionej w\u0142a\u015bciwo\u015bci.",
        "queryParams": [
          {
            "name": "minDate",
            "required": false,
            "type": "datetime",
            "description": "Pocz\u0105tek zakresu dat. Parsowana przez [datetime]::Parse.",
            "format": "YYYY-MM-DD",
            "examples": ["2025-01-01"]
          },
          {
            "name": "maxDate",
            "required": false,
            "type": "datetime",
            "description": "Koniec zakresu dat. Parsowana przez [datetime]::Parse.",
            "format": "YYYY-MM-DD",
            "examples": ["2025-12-31"]
          },
          {
            "name": "entity",
            "required": false,
            "type": "string",
            "description": "Filtrowanie po nazwie encji.",
            "examples": ["Smok", "Tawerna"]
          },
          {
            "name": "property",
            "required": false,
            "type": "string",
            "description": "Filtrowanie po nazwie zmienionej w\u0142a\u015bciwo\u015bci.",
            "examples": ["@status", "@lokacja"]
          }
        ]
      },
      "en": {
        "description": "Returns the entity change audit log with optional filtering by date range, entity name, and changed property.",
        "queryParams": [
          {
            "name": "minDate",
            "required": false,
            "type": "datetime",
            "description": "Start of date range. Parsed via [datetime]::Parse.",
            "format": "YYYY-MM-DD",
            "examples": ["2025-01-01"]
          },
          {
            "name": "maxDate",
            "required": false,
            "type": "datetime",
            "description": "End of date range. Parsed via [datetime]::Parse.",
            "format": "YYYY-MM-DD",
            "examples": ["2025-12-31"]
          },
          {
            "name": "entity",
            "required": false,
            "type": "string",
            "description": "Filter by entity name.",
            "examples": ["Smok", "Tawerna"]
          },
          {
            "name": "property",
            "required": false,
            "type": "string",
            "description": "Filter by changed property name.",
            "examples": ["@status", "@lokacja"]
          }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/reports/dormancy",
      "handler": "Invoke-ApiGetDormancy",
      "scope": "admin:read",
      "pl": {
        "description": "Zwraca raport nieaktywnych encji na podstawie progu bezruchu w miesi\u0105cach.",
        "queryParams": [
          {
            "name": "thresholdMonths",
            "required": false,
            "type": "integer",
            "description": "Pr\u00f3g nieaktywno\u015bci w miesi\u0105cach.",
            "examples": [3, 6]
          },
          {
            "name": "type",
            "required": false,
            "type": "string",
            "description": "Filtrowanie po typie encji.",
            "examples": ["NPC", "Lokacja"]
          },
          {
            "name": "includeDeleted",
            "required": false,
            "type": "string",
            "description": "Warto\u015b\u0107 'true' w\u0142\u0105cza encje usuni\u0119te mi\u0119kko (@status: Usuni\u0119ty).",
            "examples": ["true"]
          }
        ]
      },
      "en": {
        "description": "Returns an inactive entity report based on the dormancy threshold in months.",
        "queryParams": [
          {
            "name": "thresholdMonths",
            "required": false,
            "type": "integer",
            "description": "Inactivity threshold in months.",
            "examples": [3, 6]
          },
          {
            "name": "type",
            "required": false,
            "type": "string",
            "description": "Filter by entity type.",
            "examples": ["NPC", "Lokacja"]
          },
          {
            "name": "includeDeleted",
            "required": false,
            "type": "string",
            "description": "Set to 'true' to include soft-deleted entities (@status: Usuni\u0119ty).",
            "examples": ["true"]
          }
        ]
      }
    },
