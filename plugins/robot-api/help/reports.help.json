    {
      "method": "GET",
      "path": "/reports/locations",
      "handler": "Invoke-ApiGetLocations",
      "scope": "admin:read",
      "pl": {
        "description": "Zwraca encje lokacji przez potok zapyta\u0144 RSQL (filtrowanie, sortowanie, paginacja, wyb\u00f3r p\u00f3l).",
        "queryParams": [
          {
            "name": "filter",
            "required": false,
            "type": "string",
            "description": "Filtr RSQL do zawierania spo\u015br\u00f3d lokacji.",
            "examples": ["name==Krak*", "type==Miasto"]
          },
          {
            "name": "sort",
            "required": false,
            "type": "string",
            "description": "Pola sortowania (prefix '-' dla malej\u0105co).",
            "examples": ["name", "-lastModified"]
          },
          {
            "name": "fields",
            "required": false,
            "type": "string",
            "description": "Wyb\u00f3r p\u00f3l zwracanych w odpowiedzi (sparse fieldset).",
            "examples": ["name,type,status"]
          },
          {
            "name": "labels",
            "required": false,
            "type": "string",
            "description": "Warto\u015b\u0107 'true' do\u0142\u0105cza przetumaczone etykiety p\u00f3l.",
            "examples": ["true"]
          },
          {
            "name": "page[size]",
            "required": false,
            "type": "integer",
            "description": "Liczba wynik\u00f3w na stron\u0119.",
            "examples": [20, 50]
          },
          {
            "name": "page[cursor]",
            "required": false,
            "type": "string",
            "description": "Kursor paginacji do pobrania nast\u0119pnej strony wynik\u00f3w."
          }
        ]
      },
      "en": {
        "description": "Returns location entities via the RSQL query pipeline (filter, sort, paginate, sparse fieldset).",
        "queryParams": [
          {
            "name": "filter",
            "required": false,
            "type": "string",
            "description": "RSQL filter expression for locations.",
            "examples": ["name==Krak*", "type==Miasto"]
          },
          {
            "name": "sort",
            "required": false,
            "type": "string",
            "description": "Sort fields (prefix with '-' for descending).",
            "examples": ["name", "-lastModified"]
          },
          {
            "name": "fields",
            "required": false,
            "type": "string",
            "description": "Sparse fieldset \u2014 comma-separated list of fields to include in the response.",
            "examples": ["name,type,status"]
          },
          {
            "name": "labels",
            "required": false,
            "type": "string",
            "description": "Set to 'true' to include translated field labels.",
            "examples": ["true"]
          },
          {
            "name": "page[size]",
            "required": false,
            "type": "integer",
            "description": "Number of results per page.",
            "examples": [20, 50]
          },
          {
            "name": "page[cursor]",
            "required": false,
            "type": "string",
            "description": "Pagination cursor for fetching the next page of results."
          }
        ]
      }
    },
