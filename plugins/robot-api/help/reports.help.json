      "en": {
        "description": "Returns the location containment and movement topology graph.",
        "queryParams": [
          {
            "name": "minDate",
            "required": false,
            "type": "datetime",
            "description": "Start of date range. Parsed via [datetime]::Parse.",
            "format": "YYYY-MM-DD",
            "examples": ["2025-01-01"]
          },
          {
            "name": "maxDate",
            "required": false,
            "type": "datetime",
            "description": "End of date range. Parsed via [datetime]::Parse.",
            "format": "YYYY-MM-DD",
            "examples": ["2025-12-31"]
          },
          {
            "name": "includeMovementEdges",
            "required": false,
            "type": "string",
            "description": "Set to 'true' to include session-based movement edges between locations.",
            "examples": ["true"]
          }
        ]
      }
